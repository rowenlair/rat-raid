      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[-- Combines class + perk + active consumables into one stat lookup.
local Classes = require(script.Parent.Classes)
local Perks = require(script.Parent.Perks)
local ShopItems = require(script.Parent.ShopItems)

local Stats = {}

local function sources(state)
	local list = {}
	local side = state.side
	if side then
		local classDef = Classes[side] and Classes[side].list[state.classId or ""]
		if classDef then
			table.insert(list, classDef)
		end
		local perkDef = Perks[side] and Perks[side].list[state.perkId or ""]
		if perkDef then
			table.insert(list, perkDef)
		end
	end
	for _, itemId in ipairs(state.active or {}) do
		local item = ShopItems.list[itemId]
		if item then
			table.insert(list, item)
		end
	end
	return list
end

-- Sum of a stat across all sources (0 if absent).
function Stats.add(state, key: string): number
	local total = 0
	for _, src in ipairs(sources(state)) do
		local v = src.stats and src.stats[key]
		if type(v) == "number" then
			total += v
		end
	end
	return total
end

-- Product of a multiplier stat (1 if absent).
function Stats.mult(state, key: string): number
	local total = 1
	for _, src in ipairs(sources(state)) do
		local v = src.stats and src.stats[key]
		if type(v) == "number" then
			total *= v
		end
	end
	return total
end

-- Largest value of a stat, or the default.
function Stats.max(state, key: string, default: number): number
	local best = default
	for _, src in ipairs(sources(state)) do
		local v = src.stats and src.stats[key]
		if type(v) == "number" and v > best then
			best = v
		end
	end
	return best
end

return Stats
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Rat Raid server entry point. Wires up every service and routes client actions.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ServicesFolder = script.Parent:WaitForChild("Services")

local S = {
	State = require(ServicesFolder.State),
	Data = require(ServicesFolder.Data),
	Character = require(ServicesFolder.Character),
	Round = require(ServicesFolder.Round),
	Food = require(ServicesFolder.Food),
	Combat = require(ServicesFolder.Combat),
	Cage = require(ServicesFolder.Cage),
	Ability = require(ServicesFolder.Ability),
	Shop = require(ServicesFolder.Shop),
}

for _, service in pairs(S) do
	if type(service.init) == "function" then
		service.init(S)
	end
end

-- Simple per-player rate limit on client actions.
local function allowAction(player: Player): boolean
	local st = S.State.get(player)
	local now = os.clock()
	if now - st.actionWindow > 1 then
		st.actionWindow = now
		st.actionBudget = 0
	end
	st.actionBudget += 1
	return st.actionBudget <= 25
end

Remotes.Action.OnServerEvent:Connect(function(player, action, a, b, c)
	if type(action) ~= "string" or not allowAction(player) then
		return
	end
	local st = S.State.get(player)
	if action == "pref" then
		if (a == "Rat" or a == "Home" or a == "Any") and not st.inMatch then
			st.pref = a
		end
	elseif action == "equip" then
		S.Shop.equip(player, a, b, c)
	elseif action == "tool" then
		if type(a) == "string" and typeof(b) == "Vector3" then
			S.Combat.useTool(player, a, b)
		end
	elseif action == "ability" then
		if typeof(a) == "Vector3" then
			S.Ability.use(player, a)
		end
	elseif action == "drop" then
		if st.inMatch and st.side == "Rat" then
			S.Food.drop(player)
		end
	end
end)

Players.PlayerAdded:Connect(function(player)
	S.Data.load(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(S.Data.load, player)
end

Players.PlayerRemoving:Connect(function(player)
	pcall(S.Food.drop, player)
	S.State.remove(player)
end)

S.Data.start()
S.Character.start()
S.Combat.start()
S.Food.start()
S.Cage.start()
S.Shop.start()
S.Round.start()

print("[RatRaid] Server ready.")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Ability</string>
            <string name="Source"><![CDATA[-- Class abilities, triggered with Q.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared.Classes)

local Ability = {}
local S

function Ability.init(services)
	S = services
end

local handlers = {}

handlers.Dash = function(player)
	S.Character.buffSpeed(player, 30, 0.6)
	return true
end

handlers.Stampede = function(player)
	local st = S.State.get(player)
	st.immuneUntil = os.clock() + 3
	st.stunnedUntil = 0
	S.Character.buffSpeed(player, 8, 3)
	return true
end

handlers.SmokeBomb = function(player)
	local root = S.Character.getRoot(player)
	if not root then
		return false
	end
	local cloud = Instance.new("Part")
	cloud.Name = "SmokeCloud"
	cloud.Anchored = true
	cloud.CanCollide = false
	cloud.CanQuery = false
	cloud.CanTouch = false
	cloud.Transparency = 1
	cloud.Size = Vector3.one
	cloud.CFrame = CFrame.new(root.Position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 9) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Rate = 60
	emitter.Speed = NumberRange.new(3, 6)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = cloud
	cloud.Parent = workspace
	task.delay(5, function()
		emitter.Enabled = false
	end)
	Debris:AddItem(cloud, 8)
	S.Character.buffSpeed(player, 6, 2)
	return true
end

handlers.Shout = function(player)
	local root = S.Character.getRoot(player)
	if not root then
		return false
	end
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Shape = Enum.PartType.Ball
	ring.Material = Enum.Material.ForceField
	ring.Color = Color3.fromRGB(255, 140, 40)
	ring.Size = Vector3.one * 2
	ring.CFrame = root.CFrame
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.4), { Size = Vector3.one * 28, Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.5)
	local hits = 0
	for _, rat in ipairs(S.Round.playersOnSide("Rat")) do
		local rroot = S.Character.getRoot(rat)
		if rroot and (rroot.Position - root.Position).Magnitude <= 14 then
			if S.Character.stun(rat, 1.5) then
				hits += 1
			end
		end
	end
	S.Round.notify(player, hits > 0 and ("Stunned %d rat(s)!"):format(hits) or "No rats in earshot.", "info")
	return true
end

handlers.TrapToss = function(player, aimPos)
	local root = S.Character.getRoot(player)
	if not root then
		return false
	end
	local offset = aimPos - root.Position
	if offset.Magnitude > 35 then
		aimPos = root.Position + offset.Unit * 35
	end
	S.Combat.placeTrap(player, aimPos)
	return true
end

handlers.RatSense = function(player)
	S.Round.effect(player, "RatSense", { duration = 4 })
	return true
end

function Ability.use(player: Player, aimPos: Vector3)
	local st = S.State.get(player)
	if not (S.Round.isMatchActive() and st.inMatch and st.side and st.classId) then
		return
	end
	if st.caged or os.clock() < st.stunnedUntil or not S.Character.getHumanoid(player) then
		return
	end
	if os.clock() < st.abilityReadyAt then
		return
	end
	local classDef = Classes[st.side].list[st.classId]
	local abilityId = classDef and classDef.ability
	local handler = abilityId and handlers[abilityId]
	if not handler then
		return
	end
	if handler(player, aimPos) then
		st.abilityReadyAt = os.clock() + Classes.Abilities[abilityId].cooldown
		S.Round.effect(player, "AbilityUsed", { id = abilityId })
	end
end

return Ability
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Cage</string>
            <string name="Source"><![CDATA[-- Netted rats go to the cage. A free teammate who touches the cage rescues them.
-- If every rat is caged at once, the homeowners win (checked in Round).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Stats = require(Shared.Stats)

local Cage = {}
local S

function Cage.init(services)
	S = services
end

local function cageParts()
	local map = workspace:FindFirstChild("Map")
	local cage = map and map:FindFirstChild("Cage")
	if not cage then
		return nil, nil, nil
	end
	return cage, cage:FindFirstChild("CageSpot"), cage:FindFirstChild("CageExit")
end

function Cage.cage(rat: Player, captor: Player)
	local st = S.State.get(rat)
	local root = S.Character.getRoot(rat)
	local _, spot = cageParts()
	if st.caged or not root or not spot then
		return
	end
	S.Food.drop(rat)
	st.caged = true
	st.cagedAt = os.clock()
	st.lastDamager = captor
	st.lastDamageTime = os.clock()
	st.lastDamageKind = "Cage"
	local char = rat.Character
	if char then
		char:PivotTo(spot.CFrame + Vector3.new(0, 1, 0))
	end
	root.Anchored = true
	S.Character.recompute(rat)
	S.Round.rewardCapture(captor, rat)
	S.Round.effect(rat, "Caged", {})
	S.Round.notify(rat, "CAGED! Your teammate has to touch the cage to free you.", "warn")
end

function Cage.release(rat: Player, rescuer: Player?)
	local st = S.State.get(rat)
	if not st.caged then
		return
	end
	st.caged = false
	local root = S.Character.getRoot(rat)
	local _, _, exit = cageParts()
	if root then
		root.Anchored = false
		if exit and rat.Character then
			rat.Character:PivotTo(exit.CFrame + Vector3.new(math.random(-10, 10) / 10, 1.5, 0))
		end
	end
	S.Character.recompute(rat)
	if rescuer then
		S.Data.addCurrency(rescuer, "Crumbs", Config.Rewards.Rescue)
		S.Data.addStat(rescuer, "rescues", 1)
		S.State.get(rescuer).matchStats.rescues += 1
		S.Round.notify(nil, ("%s broke %s out of the cage!"):format(rescuer.DisplayName, rat.DisplayName), "food")
		S.Round.notify(rescuer, ("+%d Crumbs (rescue)"):format(Config.Rewards.Rescue), "good")
	end
end

function Cage.releaseAll()
	for _, p in ipairs(Players:GetPlayers()) do
		local st = S.State.get(p)
		if st.caged then
			st.caged = false
			local root = S.Character.getRoot(p)
			if root then
				root.Anchored = false
			end
		end
	end
end

local function tick()
	if not S.Round.isMatchActive() then
		return
	end
	local cage, spot = cageParts()
	if not (cage and spot) then
		return
	end
	local rats = S.Round.playersOnSide("Rat")
	local caged = {}
	for _, rat in ipairs(rats) do
		local st = S.State.get(rat)
		if st.caged then
			local timeout = Stats.max(st, "cageTimeout", Config.CAGE_TIMEOUT)
			if os.clock() - st.cagedAt >= timeout then
				-- Exterminated: costs a life (handled by Round.onDied).
				S.Round.notify(nil, rat.DisplayName .. " was exterminated!", "kill")
				local hum = S.Character.getHumanoid(rat)
				st.caged = false
				local root = S.Character.getRoot(rat)
				if root then
					root.Anchored = false
				end
				if hum then
					hum.Health = 0
				end
			else
				table.insert(caged, rat)
			end
		end
	end
	if #caged == 0 then
		return
	end
	for _, rescuer in ipairs(rats) do
		local st = S.State.get(rescuer)
		local root = S.Character.getRoot(rescuer)
		if not st.caged and root and S.Character.getHumanoid(rescuer) then
			local range = Stats.max(st, "rescueRange", Config.RESCUE_RANGE)
			if (root.Position - spot.Position).Magnitude <= range then
				for _, rat in ipairs(caged) do
					Cage.release(rat, rescuer)
				end
				return
			end
		end
	end
end

function Cage.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(tick)
			if not ok then
				warn("[RatRaid] Cage tick error:", err)
			end
		end
	end)
end

return Cage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Character</string>
            <string name="Source"><![CDATA[-- Spawning, rat transformation, movement speed, stuns.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Stats = require(Shared.Stats)

local Character = {}
local S

local RAT_GREY = Color3.fromRGB(125, 120, 118)
local RAT_PINK = Color3.fromRGB(255, 165, 180)

function Character.init(services)
	S = services
end

local function spawnCFrame(name: string): CFrame?
	local map = workspace:FindFirstChild("Map")
	local spawns = map and map:FindFirstChild("Spawns")
	local spot = spawns and spawns:FindFirstChild(name)
	if spot and spot:IsA("BasePart") then
		local jitter = Vector3.new(math.random(-20, 20) / 10, 3, math.random(-20, 20) / 10)
		return CFrame.new(spot.Position + jitter) * (spot.CFrame - spot.Position)
	end
	return nil
end
Character.spawnCFrame = spawnCFrame

local function waitForAppearance(player: Player, timeout: number)
	if player:HasAppearanceLoaded() then
		return
	end
	local done = false
	local conn = player.CharacterAppearanceLoaded:Connect(function()
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout do
		task.wait(0.1)
	end
	conn:Disconnect()
end

local function cosmetic(name, size, color, cframe, shape, parent, weldTo)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CFrame = cframe
	p.Parent = parent
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = weldTo
	weld.Part1 = p
	weld.Parent = p
	return p
end

-- Turns a normal avatar into a placeholder rat. Swap this out for a custom
-- rat model later (see README: "Replacing the placeholder rat").
function Character.applyRatLook(player: Player, char: Model)
	waitForAppearance(player, 3)
	if not char.Parent then
		return
	end

	local function strip(inst)
		if inst:IsA("Accessory") or inst:IsA("Shirt") or inst:IsA("Pants") or inst:IsA("ShirtGraphic") then
			inst:Destroy()
		end
	end
	for _, child in ipairs(char:GetChildren()) do
		strip(child)
	end
	char.ChildAdded:Connect(function(child)
		task.defer(strip, child)
	end)

	local bodyColors = char:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.HeadColor3 = RAT_GREY
		bodyColors.TorsoColor3 = RAT_GREY
		bodyColors.LeftArmColor3 = RAT_PINK
		bodyColors.RightArmColor3 = RAT_PINK
		bodyColors.LeftLegColor3 = RAT_GREY
		bodyColors.RightLegColor3 = RAT_GREY
	end

	char:ScaleTo(Config.RAT_SCALE)

	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
	if head and head:IsA("BasePart") then
		local hs = head.Size.Y
		for _, sideSign in ipairs({ -1, 1 }) do
			cosmetic("RatEar", Vector3.new(hs * 0.15, hs * 0.85, hs * 0.85), RAT_PINK,
				head.CFrame * CFrame.new(sideSign * hs * 0.5, hs * 0.6, 0) * CFrame.Angles(0, math.rad(90), 0),
				Enum.PartType.Cylinder, char, head)
		end
		cosmetic("RatNose", Vector3.new(hs * 0.25, hs * 0.25, hs * 0.25), RAT_PINK,
			head.CFrame * CFrame.new(0, -hs * 0.05, -head.Size.Z * 0.55), Enum.PartType.Ball, char, head)
	end
	if torso and torso:IsA("BasePart") then
		local len = torso.Size.Y * 3
		cosmetic("RatTail", Vector3.new(len, torso.Size.Y * 0.15, torso.Size.Y * 0.15), RAT_PINK,
			torso.CFrame * CFrame.new(0, -torso.Size.Y * 0.2, torso.Size.Z * 0.5 + len * 0.45)
				* CFrame.Angles(math.rad(20), 0, 0) * CFrame.Angles(0, math.rad(90), 0),
			Enum.PartType.Cylinder, char, torso)
	end
end

function Character.setup(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hum or not hrp then
		return
	end
	local st = S.State.get(player)

	hum.Died:Connect(function()
		S.Round.onDied(player)
	end)
	hum.UseJumpPower = true

	if st.inMatch and st.side == "Rat" then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		local early = spawnCFrame("RatSpawn")
		if early then
			char:PivotTo(early) -- get them out of the lobby right away
		end
		Character.applyRatLook(player, char)
		if not char.Parent then
			return
		end
		hum.MaxHealth = Config.RAT_HEALTH + Stats.add(st, "maxHealthBonus")
		hum.Health = hum.MaxHealth
		local cf = spawnCFrame("RatSpawn")
		if cf then
			char:PivotTo(cf)
		end
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 3
		player.CameraMaxZoomDistance = 14
	elseif st.inMatch and st.side == "Home" then
		hum.MaxHealth = 100
		hum.Health = 100
		local cf = spawnCFrame("HomeSpawn")
		if cf then
			char:PivotTo(cf)
		end
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		S.Combat.giveTools(player)
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 30
	end
	Character.recompute(player)
end

function Character.getHumanoid(player: Player): Humanoid?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		return hum
	end
	return nil
end

function Character.getRoot(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Character.recompute(player: Player)
	local hum = Character.getHumanoid(player)
	if not hum then
		return
	end
	local st = S.State.get(player)
	local now = os.clock()

	if st.caged or now < st.stunnedUntil then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		return
	end

	local speed, jump
	if st.inMatch and st.side == "Rat" then
		speed = Config.RAT_WALKSPEED
		jump = Config.RAT_JUMPPOWER
	elseif st.inMatch and st.side == "Home" then
		speed = Config.HOME_WALKSPEED
		jump = Config.HOME_JUMPPOWER
	else
		speed = 16
		jump = 50
	end

	if st.inMatch then
		speed += Stats.add(st, "speed")
		if now < st.speedBuffUntil then
			speed += st.speedBuff
		end
		if st.carrying and st.carrying.Parent then
			local weight = (st.carrying:GetAttribute("Weight") or 0) * Stats.mult(st, "weightMult")
			speed *= math.clamp(1 - weight, 0.25, 1)
		end
	end
	hum.WalkSpeed = speed
	hum.JumpPower = jump
end

function Character.stun(player: Player, duration: number)
	local st = S.State.get(player)
	if os.clock() < st.immuneUntil then
		return false
	end
	st.stunnedUntil = math.max(st.stunnedUntil, os.clock() + duration)
	Character.recompute(player)
	S.Round.effect(player, "Stun", { duration = duration })
	return true
end

function Character.buffSpeed(player: Player, amount: number, duration: number)
	local st = S.State.get(player)
	st.speedBuff = amount
	st.speedBuffUntil = os.clock() + duration
	Character.recompute(player)
end

function Character.start()
	Players.RespawnTime = Config.RAT_RESPAWN_TIME

	local function hook(player)
		player.CharacterAdded:Connect(function(char)
			task.spawn(Character.setup, player, char)
		end)
		if player.Character then
			task.spawn(Character.setup, player, player.Character)
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)

	-- Keep speeds fresh (stun/buff expiry, carrying changes).
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, p in ipairs(Players:GetPlayers()) do
				if S.State.get(p).inMatch then
					Character.recompute(p)
				end
			end
		end
	end)
end

return Character
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Homeowner weapons: Net (capture), Electric Flyswatter, Pellet Gun, Mousetraps.
-- All hit detection is done on the server; clients only send "I clicked, aiming here".
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Stats = require(Shared.Stats)

local Combat = {}
local S

local trapsFolder: Folder
local TOOL_NAMES = { "Net", "Flyswatter", "PelletGun", "Mousetrap" }

function Combat.init(services)
	S = services
end

----------------------------------------------------------------------
-- Tool construction (placeholder art built from Parts)
----------------------------------------------------------------------
local function part(props)
	local p = Instance.new("Part")
	p.CanCollide = false
	p.Massless = true
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Shape = props.Shape or Enum.PartType.Block
	p.Size = props.Size
	p.Color = props.Color
	p.Transparency = props.Transparency or 0
	p.Name = props.Name or "Part"
	return p
end

local function attach(tool: Tool, handle: BasePart, p: BasePart, offset: CFrame)
	p.CFrame = handle.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = handle
	w.Part1 = p
	w.Parent = p
	p.Parent = tool
end

local function newTool(name: string, tip: string, handleSize: Vector3, color: Color3)
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.ToolTip = tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("RatRaidTool", true)
	local handle = part({ Name = "Handle", Size = handleSize, Color = color })
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	return tool, handle
end

local builders = {}

builders.Net = function()
	local tool, h = newTool("Net", "Catch a rat and send it to the cage!", Vector3.new(0.25, 0.25, 4), Color3.fromRGB(150, 110, 70))
	attach(tool, h, part({ Size = Vector3.new(0.15, 2.2, 2.2), Color = Color3.fromRGB(230, 230, 230),
		Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal }), CFrame.new(0, 0, -3) * CFrame.Angles(0, 0, math.rad(90)))
	attach(tool, h, part({ Size = Vector3.new(1.8, 1.6, 1.8), Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0.6, Material = Enum.Material.ForceField }), CFrame.new(0, -0.8, -3))
	return tool
end

builders.Flyswatter = function()
	local tool, h = newTool("Flyswatter", "ZAP! Damages and stuns rats.", Vector3.new(0.25, 0.25, 2.5), Color3.fromRGB(240, 200, 40))
	attach(tool, h, part({ Size = Vector3.new(2, 0.15, 2.4), Color = Color3.fromRGB(60, 160, 255),
		Material = Enum.Material.Neon, Transparency = 0.2 }), CFrame.new(0, 0, -2.4))
	local spark = Instance.new("PointLight")
	spark.Color = Color3.fromRGB(80, 170, 255)
	spark.Range = 6
	spark.Parent = h
	return tool
end

builders.PelletGun = function()
	local tool, h = newTool("PelletGun", "Ranged pellet gun. Limited ammo!", Vector3.new(0.4, 0.8, 1.2), Color3.fromRGB(60, 60, 65))
	attach(tool, h, part({ Size = Vector3.new(0.3, 0.3, 2.4), Color = Color3.fromRGB(40, 40, 45),
		Material = Enum.Material.Metal }), CFrame.new(0, 0.35, -1.5))
	attach(tool, h, part({ Size = Vector3.new(0.35, 0.5, 0.9), Color = Color3.fromRGB(120, 80, 50),
		Material = Enum.Material.Wood }), CFrame.new(0, 0.2, 0.9))
	return tool
end

builders.Mousetrap = function()
	local tool, h = newTool("Mousetrap", "Click to place a trap in front of you.", Vector3.new(1.2, 0.2, 2), Color3.fromRGB(210, 170, 110))
	h.Material = Enum.Material.Wood
	attach(tool, h, part({ Size = Vector3.new(1.1, 0.1, 0.1), Color = Color3.fromRGB(180, 180, 185),
		Material = Enum.Material.Metal }), CFrame.new(0, 0.15, -0.3))
	return tool
end

function Combat.giveTools(player: Player)
	local backpack = player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("RatRaidTool") then
					item:Destroy()
				end
			end
		end
	end
	for _, name in ipairs(TOOL_NAMES) do
		builders[name]().Parent = backpack
	end
end

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function cooldownReady(st, key: string, cooldown: number): boolean
	local now = os.clock()
	if (st.cooldowns[key] or 0) > now then
		return false
	end
	st.cooldowns[key] = now + cooldown
	return true
end

local function flash(position: Vector3, color: Color3, size: number, life: number)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.3
	p.Size = Vector3.one * size
	p.CFrame = CFrame.new(position)
	p.Parent = workspace
	Debris:AddItem(p, life)
end

-- Returns the rat player (in match, alive, not caged) closest to the aim cone.
local function findRatInFront(player: Player, aimPos: Vector3, range: number): Player?
	local root = S.Character.getRoot(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not (root and head) then
		return nil
	end
	local dir = aimPos - head.Position
	if dir.Magnitude < 0.01 then
		dir = root.CFrame.LookVector
	end
	dir = dir.Unit

	local best, bestDist = nil, math.huge
	for _, rat in ipairs(S.Round.playersOnSide("Rat")) do
		local rst = S.State.get(rat)
		local rroot = S.Character.getRoot(rat)
		if rroot and not rst.caged and S.Character.getHumanoid(rat) then
			local rel = rroot.Position - head.Position
			local dist = rel.Magnitude
			if dist <= range then
				local facing = rel.Unit:Dot(dir)
				if (facing > 0.55 or dist < 3.5) and dist < bestDist then
					best, bestDist = rat, dist
				end
			end
		end
	end
	return best
end

function Combat.damageRat(attacker: Player, rat: Player, amount: number, kind: string)
	local rst = S.State.get(rat)
	local hum = S.Character.getHumanoid(rat)
	if not hum or rst.caged or not rst.inMatch or rst.side ~= "Rat" then
		return
	end
	rst.lastDamager = attacker
	rst.lastDamageTime = os.clock()
	rst.lastDamageKind = kind
	hum:TakeDamage(amount)
	S.Round.effect(rat, "Hurt", { kind = kind })
	S.Round.effect(attacker, "HitMarker", {})
end

----------------------------------------------------------------------
-- Mousetraps
----------------------------------------------------------------------
local function snapTrap(model: Model, bar: BasePart)
	model:SetAttribute("Armed", false)
	bar.CFrame = bar.CFrame * CFrame.new(0, 0, 0.6) * CFrame.Angles(math.rad(-80), 0, 0)
	bar.Color = Color3.fromRGB(255, 80, 80)
	Debris:AddItem(model, 2)
end

function Combat.placeTrap(owner: Player, position: Vector3)
	-- Snap to the floor below the point.
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { trapsFolder }
	if owner.Character then
		table.insert(ignore, owner.Character)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -30, 0), params)
	local floorPos = hit and hit.Position or position
	local yaw = math.random() * math.pi * 2

	local model = Instance.new("Model")
	model.Name = "Mousetrap"
	model:SetAttribute("Armed", true)
	model:SetAttribute("Owner", owner.UserId)

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Anchored = true
	base.CanCollide = false
	base.Size = Vector3.new(1.4, 0.2, 2.4)
	base.Material = Enum.Material.Wood
	base.Color = Color3.fromRGB(210, 170, 110)
	base.CFrame = CFrame.new(floorPos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, yaw, 0)
	base.Parent = model

	local bar = Instance.new("Part")
	bar.Name = "Bar"
	bar.Anchored = true
	bar.CanCollide = false
	bar.CanTouch = false
	bar.Size = Vector3.new(1.3, 0.1, 0.1)
	bar.Material = Enum.Material.Metal
	bar.Color = Color3.fromRGB(190, 190, 195)
	bar.CFrame = base.CFrame * CFrame.new(0, 0.15, 0.9)
	bar.Parent = model

	local bait = Instance.new("Part")
	bait.Name = "Bait"
	bait.Anchored = true
	bait.CanCollide = false
	bait.CanTouch = false
	bait.Size = Vector3.new(0.4, 0.3, 0.4)
	bait.Color = Color3.fromRGB(255, 206, 60)
	bait.CFrame = base.CFrame * CFrame.new(0, 0.25, -0.4)
	bait.Parent = model

	local trigger = Instance.new("Part")
	trigger.Name = "Trigger"
	trigger.Anchored = true
	trigger.CanCollide = false
	trigger.Transparency = 1
	trigger.Size = Vector3.new(2, 1.5, 2.8)
	trigger.CFrame = base.CFrame * CFrame.new(0, 0.75, 0)
	trigger.Parent = model

	model.PrimaryPart = base
	model.Parent = trapsFolder

	trigger.Touched:Connect(function(hitPart)
		if not model:GetAttribute("Armed") then
			return
		end
		local rat = Players:GetPlayerFromCharacter(hitPart.Parent)
		if not rat then
			return
		end
		local rst = S.State.get(rat)
		if not (rst.inMatch and rst.side == "Rat") or rst.caged then
			return
		end
		model:SetAttribute("Armed", false)
		local delayTime = Stats.add(rst, "trapDelay")
		if delayTime > 0 then
			S.Round.effect(rat, "TrapWarning", {})
			task.wait(delayTime)
		end
		snapTrap(model, bar)
		local root = S.Character.getRoot(rat)
		local hum = S.Character.getHumanoid(rat)
		if root and hum and not rst.caged and (root.Position - base.Position).Magnitude <= 2.6 then
			rst.lastDamager = owner.Parent and owner or nil
			rst.lastDamageTime = os.clock()
			rst.lastDamageKind = "Trap"
			S.Round.effect(rat, "Snap", {})
			hum.Health = 0
		elseif delayTime > 0 then
			S.Round.notify(rat, "Phew! Light Paws saved you.", "good")
		end
	end)
	return model
end

----------------------------------------------------------------------
-- Tool use
----------------------------------------------------------------------
function Combat.useTool(player: Player, toolName: string, aimPos: Vector3)
	local st = S.State.get(player)
	if not (S.Round.isMatchActive() and st.inMatch and st.side == "Home") then
		return
	end
	if os.clock() < st.stunnedUntil then
		return
	end
	local char = player.Character
	if not (char and char:FindFirstChild(toolName) and S.Character.getHumanoid(player)) then
		return -- must be holding the tool
	end
	local head = char:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end

	if toolName == "Net" then
		local cd = Config.Weapons.Net.cooldown * Stats.mult(st, "netCooldownMult")
		if not cooldownReady(st, "Net", cd) then
			return
		end
		local range = Config.Weapons.Net.range + Stats.add(st, "netRange")
		local rat = findRatInFront(player, aimPos, range)
		if rat then
			S.Cage.cage(rat, player)
		end
	elseif toolName == "Flyswatter" then
		if not cooldownReady(st, "Flyswatter", Config.Weapons.Flyswatter.cooldown) then
			return
		end
		local rat = findRatInFront(player, aimPos, Config.Weapons.Flyswatter.range)
		if rat then
			local root = S.Character.getRoot(rat)
			if root then
				flash(root.Position, Color3.fromRGB(80, 180, 255), 2.5, 0.15)
			end
			S.Character.stun(rat, Config.Weapons.Flyswatter.stun)
			Combat.damageRat(player, rat, Config.Weapons.Flyswatter.damage, "Flyswatter")
			S.Round.effect(rat, "Zap", {})
		end
	elseif toolName == "PelletGun" then
		if st.ammo <= 0 then
			S.Round.notify(player, "Out of pellets! Buy Ammo Packs in the shop.", "warn")
			return
		end
		if not cooldownReady(st, "PelletGun", Config.Weapons.PelletGun.cooldown) then
			return
		end
		st.ammo -= 1
		local origin = head.Position
		local dir = aimPos - origin
		if dir.Magnitude < 0.01 then
			return
		end
		dir = dir.Unit * Config.Weapons.PelletGun.range
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char, trapsFolder }
		local result = workspace:Spherecast(origin, 0.3, dir, params)
		local endPos = result and result.Position or (origin + dir)

		-- Tracer
		local len = (endPos - origin).Magnitude
		local tracer = Instance.new("Part")
		tracer.Anchored = true
		tracer.CanCollide = false
		tracer.CanQuery = false
		tracer.CanTouch = false
		tracer.Material = Enum.Material.Neon
		tracer.Color = Color3.fromRGB(255, 230, 120)
		tracer.Size = Vector3.new(0.08, 0.08, len)
		tracer.CFrame = CFrame.lookAt(origin, endPos) * CFrame.new(0, 0, -len / 2)
		tracer.Parent = workspace
		Debris:AddItem(tracer, 0.06)

		if result then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			local rat = model and Players:GetPlayerFromCharacter(model)
			if rat then
				local dmg = Config.Weapons.PelletGun.damage + Stats.add(st, "gunDamageBonus")
				Combat.damageRat(player, rat, dmg, "Gun")
			end
		end
	elseif toolName == "Mousetrap" then
		if st.traps <= 0 then
			S.Round.notify(player, "No traps left! Buy Extra Traps in the shop.", "warn")
			return
		end
		if not cooldownReady(st, "Mousetrap", Config.Weapons.Mousetrap.cooldown) then
			return
		end
		local root = S.Character.getRoot(player)
		if not root then
			return
		end
		st.traps -= 1
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		Combat.placeTrap(player, root.Position + look.Unit * Config.Weapons.Mousetrap.placeDistance)
	end
end

function Combat.startMatch()
	Combat.clear()
end

function Combat.clear()
	if trapsFolder then
		trapsFolder:ClearAllChildren()
	end
	for _, p in ipairs(Players:GetPlayers()) do
		for _, container in ipairs({ p:FindFirstChild("Backpack"), p.Character }) do
			if container then
				for _, item in ipairs(container:GetChildren()) do
					if item:IsA("Tool") and item:GetAttribute("RatRaidTool") then
						item:Destroy()
					end
				end
			end
		end
	end
end

function Combat.start()
	trapsFolder = Instance.new("Folder")
	trapsFolder.Name = "Traps"
	trapsFolder.Parent = workspace
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[-- Saves currencies, unlocks, equipped loadouts and lifetime stats with DataStores.
-- In Studio, enable Game Settings > Security > "Enable Studio Access to API Services"
-- to save there; otherwise profiles are session-only (the game still works).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared.Classes)
local Config = require(Shared.Config)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Data = {}
local S

local STORE_NAME = "RatRaid_v1"
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[RatRaid] DataStore unavailable, using session-only profiles:", result)
	end
end

local profiles: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}

local function defaultProfile()
	return {
		Coins = 0,
		Crumbs = 0,
		ownedClasses = { Rat = { [Classes.DEFAULT.Rat] = true }, Home = { [Classes.DEFAULT.Home] = true } },
		ownedPerks = { Rat = {}, Home = {} },
		equipped = {
			Rat = { class = Classes.DEFAULT.Rat, perk = "None" },
			Home = { class = Classes.DEFAULT.Home, perk = "None" },
		},
		inventory = {},
		stats = { wins = 0, games = 0, captures = 0, kills = 0, food = 0, rescues = 0 },
	}
end

-- Fill any missing keys from defaults (handles old saves after updates).
local function reconcile(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = (type(v) == "table") and table.clone(v) or v
		elseif type(v) == "table" and type(target[k]) == "table" then
			reconcile(target[k], v)
		end
	end
	return target
end

local function makeLeaderstats(player, profile)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = profile.Coins
	coins.Parent = ls
	local crumbs = Instance.new("IntValue")
	crumbs.Name = "Crumbs"
	crumbs.Value = profile.Crumbs
	crumbs.Parent = ls
	ls.Parent = player
end

local function refreshLeaderstats(player)
	local profile = profiles[player]
	local ls = player:FindFirstChild("leaderstats")
	if profile and ls then
		ls.Coins.Value = profile.Coins
		ls.Crumbs.Value = profile.Crumbs
	end
end

function Data.init(services)
	S = services
end

function Data.load(player: Player)
	local profile = nil
	local loaded = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync("player_" .. player.UserId)
			end)
			if ok then
				profile = result
				loaded = true
				break
			else
				warn(("[RatRaid] Load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
				task.wait(1)
			end
		end
	end
	if type(profile) ~= "table" then
		profile = defaultProfile()
	end
	reconcile(profile, defaultProfile())
	profiles[player] = profile
	canSave[player] = loaded -- never overwrite a save we failed to read
	makeLeaderstats(player, profile)
	if not loaded then
		S.Round.notify(player, "Progress won't save this session (DataStore unavailable).", "warn")
	end
	Data.push(player)
	return profile
end

function Data.save(player: Player)
	local profile = profiles[player]
	if not (store and profile and canSave[player]) then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("player_" .. player.UserId, profile)
	end)
	if not ok then
		warn("[RatRaid] Save failed for", player.Name, err)
	end
end

function Data.get(player: Player)
	return profiles[player]
end

function Data.push(player: Player)
	local profile = profiles[player]
	if profile then
		refreshLeaderstats(player)
		Remotes.ProfileUpdated:FireClient(player, profile)
	end
end

function Data.addCurrency(player: Player, currency: string, amount: number)
	local profile = profiles[player]
	if not profile or amount == 0 then
		return
	end
	profile[currency] = math.max(0, (profile[currency] or 0) + math.floor(amount))
	Data.push(player)
end

function Data.addStat(player: Player, key: string, amount: number)
	local profile = profiles[player]
	if profile then
		profile.stats[key] = (profile.stats[key] or 0) + amount
	end
end

-- Take one of each consumable the player owns for this side, return list of ids.
function Data.consumeForSide(player: Player, side: string, shopItems)
	local profile = profiles[player]
	local used = {}
	if not profile then
		return used
	end
	for _, id in ipairs(shopItems.order) do
		local item = shopItems.list[id]
		local count = profile.inventory[id] or 0
		if item.side == side and count > 0 then
			profile.inventory[id] = count - 1
			table.insert(used, id)
		end
	end
	if #used > 0 then
		Data.push(player)
	end
	return used
end

function Data.start()
	Players.PlayerRemoving:Connect(function(player)
		Data.save(player)
		profiles[player] = nil
		canSave[player] = nil
	end)

	game:BindToClose(function()
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(Data.save, player)
		end
		task.wait(2)
	end)

	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(Data.save, player)
			end
		end
	end)

	Remotes.GetProfile.OnServerInvoke = function(player)
		return profiles[player]
	end
end

Data.MAX_STACK = Config.MAX_CONSUMABLE_STACK

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Food</string>
            <string name="Source"><![CDATA[-- Spawns food, handles grab/drop/deliver to the Rat Den.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Foods = require(Shared.Foods)
local Stats = require(Shared.Stats)

local Food = {}
local S

local foodFolder: Folder
local occupied: { [BasePart]: Model } = {}
local rng = Random.new()

function Food.init(services)
	S = services
end

local function spawnPoints(): { BasePart }
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("FoodSpawns")
	local list = {}
	if folder then
		for _, p in ipairs(folder:GetChildren()) do
			if p:IsA("BasePart") then
				table.insert(list, p)
			end
		end
	end
	return list
end

local function denZone(): BasePart?
	local map = workspace:FindFirstChild("Map")
	local den = map and map:FindFirstChild("RatDen")
	return den and den:FindFirstChild("DenZone") :: BasePart?
end

local function buildFood(foodId: string, cf: CFrame): Model
	local def = Foods.list[foodId]
	local model = Instance.new("Model")
	model.Name = def.name

	local main: BasePart
	if def.shape == "Wedge" then
		main = Instance.new("WedgePart")
	else
		main = Instance.new("Part")
		if def.shape == "Ball" then
			(main :: Part).Shape = Enum.PartType.Ball
		elseif def.shape == "Cylinder" then
			(main :: Part).Shape = Enum.PartType.Cylinder
		end
	end
	main.Name = "Main"
	main.Color = def.color
	main.Material = Enum.Material.SmoothPlastic
	main.Anchored = true
	main.CanCollide = false
	if def.shape == "Cylinder" then
		-- Cylinders are along X; stand it up like a cake/cookie.
		main.Size = Vector3.new(def.size.Y, def.size.X, def.size.Z)
		main.CFrame = cf * CFrame.new(0, def.size.Y / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	else
		main.Size = def.size
		main.CFrame = cf * CFrame.new(0, def.size.Y / 2, 0)
	end
	main.Parent = model
	model.PrimaryPart = main

	model:SetAttribute("FoodId", foodId)
	model:SetAttribute("FoodName", def.name)
	model:SetAttribute("Points", def.points)
	model:SetAttribute("Weight", def.weight)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = "Grab"
	prompt.ObjectText = ("%s (+%d)"):format(def.name, def.points)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("RatOnly", true)
	prompt.Parent = main

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Range = 5
	light.Brightness = 1.2
	light.Parent = main

	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(60, 24)
	bb.StudsOffset = Vector3.new(0, 1.6, 0)
	bb.MaxDistance = 45
	bb.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "+" .. def.points
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 225, 70)
	label.TextStrokeTransparency = 0
	label.Parent = bb
	bb.Parent = main

	prompt.Triggered:Connect(function(player)
		Food.pickUp(player, model)
	end)

	model.Parent = foodFolder
	return model
end

local function spawnAt(point: BasePart)
	if occupied[point] and occupied[point].Parent then
		return
	end
	local id = Foods.randomId(rng)
	local model = buildFood(id, CFrame.new(point.Position - Vector3.new(0, point.Size.Y / 2, 0)))
	model:SetAttribute("SpawnedAt", point:GetFullName())
	occupied[point] = model
end

local function activeCount(): number
	local n = 0
	for _, m in ipairs(foodFolder:GetChildren()) do
		if m:IsA("Model") then
			n += 1
		end
	end
	return n
end

local function spawnRandom()
	if activeCount() >= Config.MAX_FOOD_ACTIVE then
		return
	end
	local free = {}
	for _, p in ipairs(spawnPoints()) do
		if not (occupied[p] and occupied[p].Parent) then
			table.insert(free, p)
		end
	end
	if #free > 0 then
		spawnAt(free[rng:NextInteger(1, #free)])
	end
end

function Food.startMatch()
	Food.clear()
	local points = spawnPoints()
	for i = #points, 2, -1 do
		local j = rng:NextInteger(1, i)
		points[i], points[j] = points[j], points[i]
	end
	for i = 1, math.min(Config.MAX_FOOD_ACTIVE, #points) do
		spawnAt(points[i])
	end
end

function Food.clear()
	if foodFolder then
		foodFolder:ClearAllChildren()
	end
	table.clear(occupied)
	for _, p in ipairs(Players:GetPlayers()) do
		S.State.get(p).carrying = nil
	end
end

function Food.pickUp(player: Player, model: Model)
	local st = S.State.get(player)
	if not (S.Round.isMatchActive() and st.inMatch and st.side == "Rat") then
		return
	end
	if st.carrying or st.caged or not model.Parent or model:GetAttribute("Carrier") then
		return
	end
	local char = player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	local root = S.Character.getRoot(player)
	local main = model.PrimaryPart
	if not (head and root and main and S.Character.getHumanoid(player)) then
		return
	end
	if (root.Position - main.Position).Magnitude > Config.FOOD_PICKUP_RANGE then
		return
	end

	-- Free its spawn point so a new one can appear later.
	for point, m in pairs(occupied) do
		if m == model then
			occupied[point] = nil
		end
	end

	model:SetAttribute("Carrier", player.UserId)
	main:FindFirstChild("GrabPrompt").Enabled = false
	local bb = main:FindFirstChild("Label")
	if bb then
		bb.Enabled = false
	end
	main.Anchored = false
	main.CanCollide = false
	main.CanQuery = false
	main.Massless = true
	local up = head.Size.Y / 2 + math.min(main.Size.X, main.Size.Y, main.Size.Z) / 2
	main.CFrame = head.CFrame * CFrame.new(0, up, 0) * (main.CFrame - main.Position).Rotation
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CarryWeld"
	weld.Part0 = head
	weld.Part1 = main
	weld.Parent = main
	st.carrying = model
	S.Character.recompute(player)
	S.Round.notify(player, ("Got the %s! Run it back to the den! [G] to drop"):format(tostring(model:GetAttribute("FoodName"))), "info")
end

function Food.drop(player: Player)
	local st = S.State.get(player)
	local model = st.carrying
	st.carrying = nil
	if not (model and model.Parent) then
		return
	end
	local main = model.PrimaryPart
	local root = S.Character.getRoot(player)
	if not main then
		model:Destroy()
		return
	end
	local weld = main:FindFirstChild("CarryWeld")
	if weld then
		weld:Destroy()
	end
	local basePos = root and root.Position or main.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { foodFolder }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(basePos + Vector3.new(0, 2, 0), Vector3.new(0, -40, 0), params)
	local floor = hit and hit.Position or basePos
	main.Anchored = true
	main.CanQuery = true
	main.CFrame = CFrame.new(floor + Vector3.new(0, main.Size.Y / 2, 0)) * (main.CFrame - main.Position).Rotation
	model:SetAttribute("Carrier", nil)
	main:FindFirstChild("GrabPrompt").Enabled = true
	local bb = main:FindFirstChild("Label")
	if bb then
		bb.Enabled = true
	end
	S.Character.recompute(player)
end

local function deliver(player: Player)
	local st = S.State.get(player)
	local model = st.carrying
	if not model then
		return
	end
	st.carrying = nil
	local points = model:GetAttribute("Points") or 0
	local name = model:GetAttribute("FoodName") or "snack"
	model:Destroy()
	S.Character.recompute(player)
	S.Round.addFood(player, points, name)
	S.Round.effect(player, "Delivered", { points = points })
	task.delay(Config.FOOD_RESPAWN_DELAY, function()
		if S.Round.isMatchActive() then
			spawnRandom()
		end
	end)
end

local function inZone(zone: BasePart, pos: Vector3): boolean
	local rel = zone.CFrame:PointToObjectSpace(pos)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z and rel.Y >= -half.Y - 2 and rel.Y <= half.Y + 2
end

local function tick(dt: number)
	if not S.Round.isMatchActive() then
		return
	end
	local zone = denZone()
	for _, rat in ipairs(S.Round.playersOnSide("Rat")) do
		local st = S.State.get(rat)
		if st.carrying then
			if not st.carrying.Parent then
				st.carrying = nil
			else
				local root = S.Character.getRoot(rat)
				if zone and root and inZone(zone, root.Position) then
					deliver(rat)
				else
					local regen = Stats.add(st, "carryRegen")
					local hum = S.Character.getHumanoid(rat)
					if regen > 0 and hum then
						hum.Health = math.min(hum.MaxHealth, hum.Health + regen * dt)
					end
				end
			end
		end
	end
	-- Keep the house stocked.
	if activeCount() < math.min(6, Config.MAX_FOOD_ACTIVE) then
		spawnRandom()
	end
end

function Food.start()
	foodFolder = Instance.new("Folder")
	foodFolder.Name = "ActiveFood"
	foodFolder.Parent = workspace
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.2)
			local now = os.clock()
			local ok, err = pcall(tick, now - last)
			last = now
			if not ok then
				warn("[RatRaid] Food tick error:", err)
			end
		end
	end)
end

return Food
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[-- The round state machine: Lobby -> Select -> Match -> Results.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Classes = require(Shared.Classes)
local ShopItems = require(Shared.ShopItems)
local Stats = require(Shared.Stats)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Round = {}
local S

local match = {
	phase = "Lobby",
	endsAt = 0,
	food = 0,
	lives = Config.RAT_LIVES,
	winner = nil,
	reason = "",
	hadHomeowners = false,
	hadRats = false,
}
Round.match = match

function Round.init(services)
	S = services
end

----------------------------------------------------------------------
-- Messaging helpers
----------------------------------------------------------------------
function Round.notify(target: Player?, text: string, kind: string?)
	if target then
		Remotes.Notify:FireClient(target, text, kind or "info")
	else
		Remotes.Notify:FireAllClients(text, kind or "info")
	end
end

function Round.effect(target: Player?, name: string, data: any)
	if target then
		Remotes.Effect:FireClient(target, name, data)
	else
		Remotes.Effect:FireAllClients(name, data)
	end
end

function Round.isMatchActive()
	return match.phase == "Match"
end

function Round.timeLeft()
	return math.max(0, match.endsAt - os.clock())
end

function Round.playersOnSide(side: string)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local st = S.State.get(p)
		if st.inMatch and st.side == side then
			table.insert(list, p)
		end
	end
	return list
end

----------------------------------------------------------------------
-- Broadcast
----------------------------------------------------------------------
local function buildState(player: Player)
	local st = S.State.get(player)
	local names = { Rat = {}, Home = {} }
	for _, side in ipairs({ "Rat", "Home" }) do
		for _, p in ipairs(Round.playersOnSide(side)) do
			table.insert(names[side], p.DisplayName)
		end
	end

	local you = {
		side = st.inMatch and st.side or nil,
		pref = st.pref,
		classId = st.classId,
		perkId = st.perkId,
		ammo = st.ammo,
		traps = st.traps,
		caged = st.caged,
		stunned = os.clock() < st.stunnedUntil,
	}
	if st.inMatch and st.side and st.classId then
		local classDef = Classes[st.side].list[st.classId]
		local ability = classDef and Classes.Abilities[classDef.ability]
		if ability then
			you.abilityName = ability.name
			you.abilityReadyIn = math.max(0, st.abilityReadyAt - os.clock())
		end
	end
	if st.carrying and st.carrying.Parent then
		you.carrying = st.carrying:GetAttribute("FoodName")
	end
	if st.caged then
		local timeout = Stats.max(st, "cageTimeout", Config.CAGE_TIMEOUT)
		you.cageTimeLeft = math.max(0, timeout - (os.clock() - st.cagedAt))
	end

	local timeLeft = 0
	if match.phase ~= "Lobby" or match.endsAt > 0 then
		timeLeft = math.max(0, match.endsAt - os.clock())
	end

	return {
		phase = match.phase,
		timeLeft = timeLeft,
		food = match.food,
		quota = Config.FOOD_QUOTA,
		lives = match.lives,
		maxLives = Config.RAT_LIVES,
		teams = names,
		winner = match.winner,
		reason = match.reason,
		playerCount = #Players:GetPlayers(),
		minPlayers = Config.MIN_PLAYERS,
		you = you,
	}
end

local function broadcast()
	for _, p in ipairs(Players:GetPlayers()) do
		Remotes.StateChanged:FireClient(p, buildState(p))
	end
end

----------------------------------------------------------------------
-- Team assignment
----------------------------------------------------------------------
local function shuffle(list)
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

local function assignTeams()
	local all = shuffle(Players:GetPlayers())
	local rat, home, any = {}, {}, {}
	for _, p in ipairs(all) do
		local pref = S.State.get(p).pref
		if pref == "Rat" then
			table.insert(rat, p)
		elseif pref == "Home" then
			table.insert(home, p)
		else
			table.insert(any, p)
		end
	end

	local result = { Rat = {}, Home = {} }
	local max = Config.MAX_PER_TEAM
	local overflow = {}
	for _, p in ipairs(rat) do
		if #result.Rat < max then table.insert(result.Rat, p) else table.insert(overflow, p) end
	end
	for _, p in ipairs(home) do
		if #result.Home < max then table.insert(result.Home, p) else table.insert(overflow, p) end
	end
	for _, list in ipairs({ any, overflow }) do
		for _, p in ipairs(list) do
			if #result.Rat <= #result.Home and #result.Rat < max then
				table.insert(result.Rat, p)
			elseif #result.Home < max then
				table.insert(result.Home, p)
			elseif #result.Rat < max then
				table.insert(result.Rat, p)
			end -- else: spectator this round
		end
	end
	-- With 2+ players, make sure both sides have someone.
	local total = #result.Rat + #result.Home
	if total >= 2 then
		if #result.Rat == 0 then
			table.insert(result.Rat, table.remove(result.Home))
		elseif #result.Home == 0 then
			table.insert(result.Home, table.remove(result.Rat))
		end
	end
	return result
end

----------------------------------------------------------------------
-- Match lifecycle
----------------------------------------------------------------------
local function applyLoadout(player: Player)
	local st = S.State.get(player)
	local profile = S.Data.get(player)
	if not (profile and st.side) then
		return
	end
	local eq = profile.equipped[st.side]
	st.classId = (eq and Classes[st.side].list[eq.class]) and eq.class or Classes.DEFAULT[st.side]
	st.perkId = eq and eq.perk or "None"
end

function Round.onEquipChanged(player: Player)
	if match.phase == "Select" then
		applyLoadout(player)
	end
end

local function beginMatch()
	match.food = 0
	match.lives = Config.RAT_LIVES
	match.winner = nil
	match.reason = ""
	match.hadHomeowners = #Round.playersOnSide("Home") > 0
	match.hadRats = #Round.playersOnSide("Rat") > 0

	S.Food.startMatch()
	S.Combat.startMatch()

	for _, p in ipairs(Players:GetPlayers()) do
		local st = S.State.get(p)
		if st.inMatch then
			st.active = S.Data.consumeForSide(p, st.side, ShopItems)
			for _, id in ipairs(st.active) do
				Round.notify(p, "Using " .. ShopItems.list[id].name .. "!", "good")
			end
			st.ammo = Config.Weapons.PelletGun.ammo + Stats.add(st, "extraAmmo")
			st.traps = Config.Weapons.Mousetrap.count + Stats.add(st, "extraTraps")
			p.Team = (st.side == "Rat") and Teams.Rats or Teams.Homeowners
			p.Neutral = false
			S.Data.addStat(p, "games", 1)
			task.spawn(function()
				p:LoadCharacter()
			end)
		end
	end
	match.phase = "Match"
	match.endsAt = os.clock() + Config.MATCH_TIME
	Round.notify(nil, "THE RAID IS ON!", "big")
end

local function finishMatch(winner: string, reason: string)
	match.winner = winner
	match.reason = reason
	match.phase = "Results"
	match.endsAt = os.clock() + Config.RESULTS_TIME

	for _, p in ipairs(Players:GetPlayers()) do
		local st = S.State.get(p)
		if st.inMatch then
			local currency = Config.CURRENCY[st.side]
			S.Data.addCurrency(p, currency, Config.Rewards.Participation)
			if st.side == winner then
				S.Data.addCurrency(p, currency, Config.Rewards.Win)
				S.Data.addStat(p, "wins", 1)
				Round.notify(p, ("+%d %s (win bonus)"):format(Config.Rewards.Win, currency), "good")
			end
		end
	end

	S.Food.clear()
	S.Combat.clear()
	S.Cage.releaseAll()
	broadcast()
end

local function cleanupToLobby()
	for _, p in ipairs(Players:GetPlayers()) do
		local st = S.State.get(p)
		local wasInMatch = st.inMatch
		S.State.resetMatch(p)
		p.Team = nil
		p.Neutral = true
		if wasInMatch then
			task.spawn(function()
				p:LoadCharacter()
			end)
		end
		S.Data.save(p)
	end
	match.phase = "Lobby"
	match.winner = nil
	match.endsAt = 0
end

local function checkWin(): (string?, string?)
	if match.food >= Config.FOOD_QUOTA then
		return "Rat", "The rats stole enough food!"
	end
	if match.lives <= 0 then
		return "Home", "The rats ran out of lives!"
	end
	local rats = Round.playersOnSide("Rat")
	local homes = Round.playersOnSide("Home")
	if match.hadRats and #rats == 0 then
		return "Home", "All rats fled the house."
	end
	if match.hadHomeowners and #homes == 0 then
		return "Rat", "The homeowners gave up."
	end
	if #rats > 0 then
		local allCaged = true
		for _, p in ipairs(rats) do
			if not S.State.get(p).caged then
				allCaged = false
				break
			end
		end
		if allCaged then
			return "Home", "Every rat is in the cage!"
		end
	end
	if Round.timeLeft() <= 0 then
		return "Home", "Time's up! The pantry is safe."
	end
	return nil, nil
end

----------------------------------------------------------------------
-- Events from other services
----------------------------------------------------------------------
function Round.onDied(player: Player)
	local st = S.State.get(player)
	if not (Round.isMatchActive() and st.inMatch) then
		return
	end
	S.Food.drop(player)
	if st.side ~= "Rat" then
		return
	end
	st.caged = false
	match.lives -= 1

	local killer = st.lastDamager
	local kind = st.lastDamageKind
	if killer and killer.Parent and os.clock() - st.lastDamageTime <= Config.KILL_CREDIT_WINDOW and kind ~= "Cage" then
		local reward = (kind == "Trap") and Config.Rewards.TrapKill or Config.Rewards.Kill
		S.Data.addCurrency(killer, "Coins", reward)
		S.Data.addStat(killer, "kills", 1)
		S.State.get(killer).matchStats.kills += 1
		local verb = ({ Trap = "trapped", Gun = "shot", Flyswatter = "zapped" })[kind or ""] or "got"
		Round.notify(nil, ("%s %s %s!"):format(killer.DisplayName, verb, player.DisplayName), "kill")
		Round.notify(killer, ("+%d Coins"):format(reward), "good")
	else
		Round.notify(nil, player.DisplayName .. " lost a life!", "kill")
	end
	st.lastDamager = nil
end

function Round.addFood(player: Player, points: number, foodName: string)
	match.food += points
	local st = S.State.get(player)
	st.matchStats.food += points
	S.Data.addStat(player, "food", points)
	local crumbs = points * Config.Rewards.CrumbsPerFoodPoint
	S.Data.addCurrency(player, "Crumbs", crumbs)
	Round.notify(nil, ("%s stashed a %s! (+%d)"):format(player.DisplayName, foodName, points), "food")
	Round.notify(player, ("+%d Crumbs"):format(crumbs), "good")
end

-- Capture reward with a time bonus: earlier captures pay more.
function Round.rewardCapture(captor: Player, rat: Player)
	local bonus = math.min(
		Config.Rewards.CaptureTimeBonusMax,
		math.floor(Round.timeLeft() / Config.Rewards.CaptureTimeBonusDivisor)
	)
	local total = Config.Rewards.CaptureBase + bonus
	S.Data.addCurrency(captor, "Coins", total)
	S.Data.addStat(captor, "captures", 1)
	S.State.get(captor).matchStats.captures += 1
	Round.notify(nil, ("%s netted %s!"):format(captor.DisplayName, rat.DisplayName), "kill")
	Round.notify(captor, ("+%d Coins (%d capture + %d time bonus)"):format(total, Config.Rewards.CaptureBase, bonus), "good")
end

----------------------------------------------------------------------
-- Main loop
----------------------------------------------------------------------
local function runLobby()
	match.phase = "Lobby"
	match.endsAt = 0
	while true do
		if #Players:GetPlayers() >= Config.MIN_PLAYERS then
			if match.endsAt == 0 then
				match.endsAt = os.clock() + Config.INTERMISSION_TIME
			end
			if os.clock() >= match.endsAt then
				return
			end
		else
			match.endsAt = 0
		end
		broadcast()
		task.wait(0.25)
	end
end

local function runSelect()
	local teams = assignTeams()
	for side, list in pairs(teams) do
		for _, p in ipairs(list) do
			local st = S.State.resetMatch(p)
			st.side = side
			st.inMatch = true
			applyLoadout(p)
			Round.notify(p, side == "Rat" and "You are a RAT! Steal the food!" or "You are a HOMEOWNER! Stop the rats!", "big")
		end
	end
	match.phase = "Select"
	match.endsAt = os.clock() + Config.SELECT_TIME
	while os.clock() < match.endsAt do
		broadcast()
		task.wait(0.25)
	end
	for _, list in pairs(teams) do
		for _, p in ipairs(list) do
			if p.Parent then
				applyLoadout(p)
			end
		end
	end
end

local function runMatch()
	beginMatch()
	while true do
		local winner, reason = checkWin()
		if winner then
			finishMatch(winner, reason :: string)
			return
		end
		broadcast()
		task.wait(0.25)
	end
end

local function runResults()
	while os.clock() < match.endsAt do
		broadcast()
		task.wait(0.25)
	end
	cleanupToLobby()
end

function Round.start()
	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				runLobby()
				runSelect()
				runMatch()
				runResults()
			end)
			if not ok then
				warn("[RatRaid] Round loop error:", err)
				pcall(S.Food.clear)
				pcall(S.Combat.clear)
				pcall(cleanupToLobby)
				task.wait(2)
			end
		end
	end)
end

return Round
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- Server-validated purchases and loadout equips.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Classes = require(Shared.Classes)
local Perks = require(Shared.Perks)
local ShopItems = require(Shared.ShopItems)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Shop = {}
local S

function Shop.init(services)
	S = services
end

local function validSide(side)
	return side == "Rat" or side == "Home"
end

function Shop.buy(player: Player, kind: any, side: any, id: any): (boolean, string)
	if type(kind) ~= "string" or type(id) ~= "string" or not validSide(side) then
		return false, "Bad request."
	end
	local profile = S.Data.get(player)
	if not profile then
		return false, "Profile still loading."
	end
	local currency = Config.CURRENCY[side]

	local def, ownedTable
	if kind == "class" then
		def = Classes[side].list[id]
		ownedTable = profile.ownedClasses[side]
	elseif kind == "perk" then
		def = Perks[side].list[id]
		ownedTable = profile.ownedPerks[side]
	elseif kind == "item" then
		def = ShopItems.list[id]
		if def and def.side ~= side then
			def = nil
		end
	end
	if not def then
		return false, "That item doesn't exist."
	end

	if ownedTable and ownedTable[id] then
		return false, "You already own that."
	end
	if kind == "item" and (profile.inventory[id] or 0) >= Config.MAX_CONSUMABLE_STACK then
		return false, ("You can hold %d at most."):format(Config.MAX_CONSUMABLE_STACK)
	end
	if (profile[currency] or 0) < def.cost then
		return false, ("Not enough %s! Need %d."):format(currency, def.cost)
	end

	profile[currency] -= def.cost
	if ownedTable then
		ownedTable[id] = true
		-- Auto-equip new unlocks
		profile.equipped[side][kind] = id
		S.Round.onEquipChanged(player)
	else
		profile.inventory[id] = (profile.inventory[id] or 0) + 1
	end
	S.Data.push(player)
	return true, ("Bought %s!"):format(def.name)
end

function Shop.equip(player: Player, side: any, kind: any, id: any)
	if not validSide(side) or (kind ~= "class" and kind ~= "perk") or type(id) ~= "string" then
		return
	end
	local profile = S.Data.get(player)
	if not profile then
		return
	end
	if kind == "class" then
		if not (Classes[side].list[id] and profile.ownedClasses[side][id]) then
			return
		end
	else
		if id ~= "None" and not (Perks[side].list[id] and profile.ownedPerks[side][id]) then
			return
		end
	end
	profile.equipped[side][kind] = id
	S.Round.onEquipChanged(player)
	S.Data.push(player)
end

function Shop.start()
	Remotes.ShopBuy.OnServerInvoke = function(player, kind, side, id)
		local ok, result, msg = pcall(Shop.buy, player, kind, side, id)
		if not ok then
			warn("[RatRaid] Shop error:", result)
			return false, "Something went wrong."
		end
		return result, msg
	end
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Per-player runtime state (not saved). Reset every match.
local State = {}

local states: { [Player]: any } = {}

local function fresh()
	return {
		pref = "Any", -- "Rat" | "Home" | "Any"
		side = nil, -- "Rat" | "Home" | nil (lobby)
		inMatch = false,
		classId = nil,
		perkId = nil,
		active = {}, -- consumable item ids used this match
		carrying = nil, -- food Model
		caged = false,
		cagedAt = 0,
		stunnedUntil = 0,
		immuneUntil = 0,
		speedBuff = 0,
		speedBuffUntil = 0,
		ammo = 0,
		traps = 0,
		abilityReadyAt = 0,
		cooldowns = {},
		lastDamager = nil,
		lastDamageTime = 0,
		lastDamageKind = nil,
		matchStats = { captures = 0, kills = 0, food = 0, rescues = 0 },
		actionBudget = 0,
		actionWindow = 0,
	}
end

function State.get(player: Player)
	local s = states[player]
	if not s then
		s = fresh()
		states[player] = s
	end
	return s
end

function State.resetMatch(player: Player)
	local s = State.get(player)
	local pref = s.pref
	local keep = fresh()
	keep.pref = pref
	states[player] = keep
	return keep
end

function State.remove(player: Player)
	states[player] = nil
end

function State.all()
	return states
end

return State
]]></string>
          </Properties>
        </Item>
      </Item>
