          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Client-only visual effects and the "only rats can see food prompts" rule.
local Teams = game:GetService("Teams")

local Effects = {}
local UI

function Effects.init(ui)
	UI = ui
end

local function ratSense(duration: number)
	local highlights = {}
	for _, p in ipairs(Teams.Rats:GetPlayers()) do
		if p.Character then
			local h = Instance.new("Highlight")
			h.FillColor = UI.Colors.red
			h.OutlineColor = UI.Colors.yellow
			h.FillTransparency = 0.3
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = p.Character
			table.insert(highlights, h)
		end
	end
	UI.toast("RAT SENSE!", "big")
	task.delay(duration, function()
		for _, h in ipairs(highlights) do
			h:Destroy()
		end
	end)
end

function Effects.play(name: string, data: any)
	data = data or {}
	if name == "Hurt" then
		UI.flash(UI.Colors.red, 0.35)
	elseif name == "Zap" then
		UI.flash(UI.Colors.blue, 0.55, 0.5)
		UI.toast("ZAPPED!", "big")
	elseif name == "Snap" then
		UI.flash(UI.Colors.red, 0.8, 0.8)
		UI.toast("SNAP!", "big")
	elseif name == "TrapWarning" then
		UI.toast("TRAP! MOVE!", "warn")
	elseif name == "Stun" then
		UI.flash(UI.Colors.white, 0.4, 0.3)
	elseif name == "Caged" then
		UI.flash(UI.Colors.ink, 0.6, 0.6)
		UI.toast("CAUGHT!", "big")
	elseif name == "Delivered" then
		UI.flash(UI.Colors.yellow, 0.35, 0.4)
		UI.toast(("+%d FOOD!"):format(data.points or 0), "big")
	elseif name == "HitMarker" then
		UI.hitMarker()
	elseif name == "RatSense" then
		ratSense(data.duration or 4)
	end
end

-- Hide food prompts from anyone who isn't currently a rat.
local function updatePrompts()
	local state = UI.getState()
	local isRat = state and state.phase == "Match" and state.you and state.you.side == "Rat"
	local folder = workspace:FindFirstChild("ActiveFood")
	if not folder then
		return
	end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d:GetAttribute("RatOnly") then
			local carried = d.Parent and d.Parent.Parent and d.Parent.Parent:GetAttribute("Carrier")
			d.Enabled = isRat and not carried and true or false
		end
	end
end

function Effects.start()
	task.spawn(function()
		while true do
			task.wait(0.3)
			pcall(updatePrompts)
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[-- Keyboard/gamepad/touch controls. All actions are validated by the server.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local mouse = player:GetMouse()

local Input = {}

local function aimPoint(): Vector3
	return mouse.Hit and mouse.Hit.Position or Vector3.zero
end

local hooked = setmetatable({}, { __mode = "k" })

local function hookTool(tool: Instance)
	if not tool:IsA("Tool") or hooked[tool] or not tool:GetAttribute("RatRaidTool") then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		Remotes.Action:FireServer("tool", tool.Name, aimPoint())
	end)
end

local function watch(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		hookTool(child)
	end
	container.ChildAdded:Connect(hookTool)
end

function Input.init()
	ContextActionService:BindAction("RatRaidAbility", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Remotes.Action:FireServer("ability", aimPoint())
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("RatRaidAbility", "Q")

	ContextActionService:BindAction("RatRaidDrop", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Remotes.Action:FireServer("drop")
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.G, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("RatRaidDrop", "Drop")

	watch(player:WaitForChild("Backpack"))
	player.CharacterAdded:Connect(function(char)
		watch(char)
		watch(player:WaitForChild("Backpack"))
	end)
	if player.Character then
		watch(player.Character)
	end
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- All 2D UI, built in code: title splash, HUD, lobby, shop/loadout, toasts, results.
-- Comic-book style inspired by the Who's Your Daddy?! trailer.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Classes = require(Shared.Classes)
local Perks = require(Shared.Perks)
local ShopItems = require(Shared.ShopItems)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local UI = {}

local C = {
	yellow = Color3.fromRGB(255, 217, 59),
	blue = Color3.fromRGB(46, 107, 255),
	darkBlue = Color3.fromRGB(24, 55, 150),
	red = Color3.fromRGB(255, 77, 77),
	green = Color3.fromRGB(80, 220, 110),
	ink = Color3.fromRGB(26, 26, 46),
	white = Color3.new(1, 1, 1),
	grey = Color3.fromRGB(125, 120, 118),
	orange = Color3.fromRGB(255, 140, 40),
	panel = Color3.fromRGB(255, 248, 225),
}
UI.Colors = C

local TITLE_FONT = Enum.Font.LuckiestGuy
local BODY_FONT = Enum.Font.FredokaOne

local gui: ScreenGui
local refs: { [string]: any } = {}
local profile = nil
local lastState = nil
local shopSide = "Rat"
local lastPhase = nil

----------------------------------------------------------------------
-- Builders
----------------------------------------------------------------------
local function new(className: string, props: { [string]: any }, children: { Instance }?)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function stroke(thickness: number?, color: Color3?)
	return new("UIStroke", { Thickness = thickness or 2, Color = color or C.ink,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

local function borderStroke(thickness: number?)
	return new("UIStroke", { Thickness = thickness or 3, Color = C.ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end

local function text(props)
	local className = props.ClassName or "TextLabel"
	local strokeSize = props.Stroke or 2
	props.ClassName = nil
	props.Stroke = nil
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or TITLE_FONT
	props.TextColor3 = props.TextColor3 or C.white
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	return new(className, props, strokeSize > 0 and { stroke(strokeSize) } or {})
end

local function button(props, onClick)
	props.ClassName = "TextButton"
	props.AutoButtonColor = true
	props.BackgroundTransparency = 0
	props.BackgroundColor3 = props.BackgroundColor3 or C.yellow
	props.TextColor3 = props.TextColor3 or C.ink
	props.Stroke = 0
	local b = text(props)
	corner(8).Parent = b
	borderStroke(3).Parent = b
	new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = b })
	b.MouseButton1Click:Connect(onClick)
	return b
end

local function fmtTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

----------------------------------------------------------------------
-- Splash (title card)
----------------------------------------------------------------------
local function buildSplash()
	local splash = new("Frame", { Name = "Splash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.blue,
		ZIndex = 50, Parent = gui })
	local rays = new("Frame", { Size = UDim2.fromScale(3, 3), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 50, Parent = splash })
	new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = rays })
	for i = 0, 11 do
		new("Frame", { Size = UDim2.new(1, 0, 0.06, 0), Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5), Rotation = i * 15, BorderSizePixel = 0,
			BackgroundColor3 = C.darkBlue, ZIndex = 50, Parent = rays })
	end
	local title = text({ Text = "RAT RAID!", Size = UDim2.fromScale(0.8, 0.3), Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5), Rotation = -6, ZIndex = 52, Stroke = 8, Parent = splash })
	new("UITextSizeConstraint", { MaxTextSize = 200, Parent = title })
	local sub = text({ Text = "2 RATS. 2 HOMEOWNERS. 1 PANTRY.", Size = UDim2.fromScale(0.7, 0.07),
		Position = UDim2.fromScale(0.5, 0.63), AnchorPoint = Vector2.new(0.5, 0.5), TextColor3 = C.yellow,
		ZIndex = 52, Stroke = 3, Parent = splash })
	new("UITextSizeConstraint", { MaxTextSize = 48, Parent = sub })
	local hint = text({ Text = "click to play", Font = BODY_FONT, Size = UDim2.fromScale(0.4, 0.04),
		Position = UDim2.fromScale(0.5, 0.9), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 52, Parent = splash })
	new("UITextSizeConstraint", { MaxTextSize = 26, Parent = hint })

	local spin = RunService.RenderStepped:Connect(function(dt)
		rays.Rotation += dt * 6
		title.Rotation = -6 + math.sin(os.clock() * 2) * 2
	end)
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		local info = TweenInfo.new(0.4)
		TweenService:Create(splash, info, { BackgroundTransparency = 1 }):Play()
		for _, d in ipairs(splash:GetDescendants()) do
			if d:IsA("Frame") then
				TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
			elseif d:IsA("TextLabel") then
				TweenService:Create(d, info, { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, info, { Transparency = 1 }):Play()
			end
		end
		task.delay(0.45, function()
			spin:Disconnect()
			splash:Destroy()
		end)
	end
	splash.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			close()
		end
	end)
	task.delay(4, close)
end

