      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Rat Raid: global tuning values. Balance the game by editing numbers here.
local RunService = game:GetService("RunService")

local Config = {}

-- Players / rounds
Config.MIN_PLAYERS = RunService:IsStudio() and 1 or 2 -- 1 lets you test alone in Studio
Config.MAX_PER_TEAM = 2
Config.INTERMISSION_TIME = 20
Config.SELECT_TIME = 10
Config.MATCH_TIME = 300
Config.RESULTS_TIME = 8

-- Win conditions
Config.FOOD_QUOTA = 100
Config.RAT_LIVES = 5

-- Rats
Config.RAT_SCALE = 0.35
Config.RAT_HEALTH = 100
Config.RAT_WALKSPEED = 22
Config.RAT_JUMPPOWER = 45
Config.RAT_RESPAWN_TIME = 6

-- Homeowners
Config.HOME_WALKSPEED = 18
Config.HOME_JUMPPOWER = 40

-- Cage
Config.CAGE_TIMEOUT = 30
Config.RESCUE_RANGE = 6

-- Food
Config.FOOD_RESPAWN_DELAY = 10
Config.MAX_FOOD_ACTIVE = 14
Config.FOOD_PICKUP_RANGE = 8

-- Weapons (homeowners)
Config.Weapons = {
	Net = { range = 8, cooldown = 1.2 },
	Flyswatter = { range = 7, cooldown = 0.8, damage = 40, stun = 1.5 },
	PelletGun = { range = 250, cooldown = 0.9, damage = 25, ammo = 12 },
	Mousetrap = { count = 3, cooldown = 1, placeDistance = 4 },
}

-- Currency per side
Config.CURRENCY = { Rat = "Crumbs", Home = "Coins" }

-- Rewards
Config.Rewards = {
	CaptureBase = 50,
	CaptureTimeBonusDivisor = 3, -- bonus = floor(secondsRemaining / divisor)
	CaptureTimeBonusMax = 100,
	Kill = 25,
	TrapKill = 15,
	CrumbsPerFoodPoint = 2,
	Rescue = 20,
	Win = 100,
	Participation = 20,
}

Config.MAX_CONSUMABLE_STACK = 5
Config.KILL_CREDIT_WINDOW = 10

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Foods</string>
          <string name="Source"><![CDATA[-- Food the rats steal. weight = fraction of speed lost while carrying (before class modifiers).
-- chance = relative spawn weight.

local Foods = {}

Foods.order = { "Cookie", "Cheese", "Apple", "Bread", "Pizza", "Cake" }

Foods.list = {
	Cookie = { id = "Cookie", name = "Crumb Cookie", points = 5, weight = 0.05, chance = 30,
		color = Color3.fromRGB(196, 140, 80), size = Vector3.new(1.4, 0.35, 1.4), shape = "Cylinder" },
	Cheese = { id = "Cheese", name = "Cheese Wedge", points = 10, weight = 0.15, chance = 25,
		color = Color3.fromRGB(255, 206, 60), size = Vector3.new(1.6, 1, 1.2), shape = "Wedge" },
	Apple = { id = "Apple", name = "Apple", points = 10, weight = 0.15, chance = 18,
		color = Color3.fromRGB(220, 40, 40), size = Vector3.new(1.3, 1.3, 1.3), shape = "Ball" },
	Bread = { id = "Bread", name = "Bread Loaf", points = 15, weight = 0.25, chance = 14,
		color = Color3.fromRGB(214, 160, 90), size = Vector3.new(2.4, 1.1, 1.3), shape = "Block" },
	Pizza = { id = "Pizza", name = "Pizza Slice", points = 20, weight = 0.3, chance = 9,
		color = Color3.fromRGB(240, 120, 50), size = Vector3.new(2, 0.3, 2.2), shape = "Wedge" },
	Cake = { id = "Cake", name = "Whole Cake", points = 40, weight = 0.55, chance = 4,
		color = Color3.fromRGB(255, 170, 200), size = Vector3.new(2.6, 1.6, 2.6), shape = "Cylinder" },
}

function Foods.randomId(rng)
	local total = 0
	for _, id in ipairs(Foods.order) do
		total += Foods.list[id].chance
	end
	local roll = (rng and rng:NextNumber() or math.random()) * total
	for _, id in ipairs(Foods.order) do
		roll -= Foods.list[id].chance
		if roll <= 0 then
			return id
		end
	end
	return Foods.order[1]
end

return Foods
]]></string>
        </Properties>
      </Item>
